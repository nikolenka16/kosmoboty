  function renderProgram(activeIndex = -1) {
    programEl.innerHTML = '';
    const maxCmds = levels[currentLevelIndex].maxCommands;
    cmdCounterEl.textContent = `${program.length} / ${maxCmds}`;
    cmdCounterEl.style.color = program.length >= maxCmds ? '#ef4444' : '#64748b';

    for (let i = 0; i < maxCmds; i++) {
      const slot = document.createElement('div');
      if (i < program.length) {
        slot.className = `cmd-slot filled ${i === activeIndex ? 'active' : ''} ${i === failedCommandIndex && !running ? 'error-command' : ''}`;
        slot.dataset.index = i; slot.dataset.cmd = program[i]; slot.title = 'Перетащи команду, чтобы переставить её или бросить в корзину'; slot.textContent = CMD_SYMBOLS[program[i]];
      } else {
        slot.className = 'cmd-slot empty'; slot.dataset.index = i; slot.title = 'Перетащи сюда стрелочку';
      }
      programEl.appendChild(slot);
    }
  }

  // =========================================
  // УПРАВЛЕНИЕ
  // =========================================
  function addCommand(cmd) { 
    if (running) return;
    failedCommandIndex = -1; 
    if (program.length >= levels[currentLevelIndex].maxCommands) {
      playSFX('error');
      return;
    }
    playSFX('click');
    program.push(cmd); 
    renderProgram(); 
  }

  function undoCommand() { 
    if (running) return; 
    playSFX('click');
    program.pop(); 
    renderProgram(); 
  }

  function hideNotification() { notification.classList.remove('show', 'success'); }
  
  function showNotification(text, isSuccess) {
    notifText.textContent = text;
    if (isSuccess) notification.classList.add('success');
    else notification.classList.remove('success');
    notification.classList.add('show');
  }

  function runProgram() {
    if (running) return;
    if (program.length === 0) {
      playSFX('error');
      return;
    }

    // Каждый новый запуск маршрута начинается с исходного состояния уровня.
    // Это позволяет исправить программу и запустить её заново после неудачной попытки.
    clearTimeout(timer);
    failedCommandIndex = -1;
    const lv = levels[currentLevelIndex];
    robot = { x: lv.start.x, y: lv.start.y, dir: lv.start.dir };
    boxes = JSON.parse(JSON.stringify(lv.boxes));
    buttons = JSON.parse(JSON.stringify(lv.buttons));

    playSFX('click');
    hideNotification();
    render();
    running = true;
    statusEl.textContent = 'Выполнение...';
    executeCommand(0);
  }

  function executeCommand(index) {
    if (!running) return;
    if (index >= program.length) {
      if (isWin()) winLevel();
      else { failedCommandIndex = Math.max(0, program.length - 1); failLevel(); }
      return;
    }
    
    const cmd = program[index];
    const ok = applyCommand(cmd);
    render(index);

    if (!ok) { failedCommandIndex = index; failLevel(); return; }
    if (isWin()) { winLevel(); return; }
    
    if (['F', 'A', 'D', 'J'].includes(cmd)) playSFX('step');
    else playSFX('turn');

    timer = setTimeout(() => executeCommand(index + 1), 400);
  }

  function failLevel() {
    running = false;
    render(failedCommandIndex);
    statusEl.textContent = 'Маршрут не завершён — проверь выделенную команду.';
    playSFX('error');
    const step = failedCommandIndex >= 0 ? failedCommandIndex + 1 : '?';
    showNotification(`Ошибка на команде №${step} — она выделена красным`, false);
  }

  function winLevel() {
    running = false;
    statusEl.textContent = 'Успех!';
    playSFX('win');
    showNotification('Уровень пройден!', true);
    if (currentLevelIndex === unlockedLevel && unlockedLevel < 29) unlockedLevel++;
    
    timer = setTimeout(() => {
      if (currentLevelIndex < 29) startLevel(currentLevelIndex + 1);
      else showLevelSelect();
    }, 2000); 
  }

  function applyCommand(cmd) {
    const lv = levels[currentLevelIndex];
    // Повороты меняют направление для команды «вперёд», но сам робот визуально не разворачивается.
    if (cmd === 'L') { robot.dir = (robot.dir + 3) % 4; return true; }
    if (cmd === 'R') { robot.dir = (robot.dir + 1) % 4; return true; }

    // Прыжок доступен только роботу Прыгун: перелетает через одну клетку.
    if (cmd === 'J') {
      if (currentRobotType !== 'prygun') return false;
      const jd = DIR_DELTA[robot.dir];
      const nx = robot.x + jd.x * 2, ny = robot.y + jd.y * 2;
      if (nx < 0 || ny < 0 || nx >= lv.size || ny >= lv.size || walls.has(`${nx},${ny}`) || boxes.some(b => b.x === nx && b.y === ny)) return false;
      robot.x = nx; robot.y = ny;
      return true;
    }

    // A и D — шаг влево/вправо по экрану без изменения направления робота.
    let d;
    if (cmd === 'A') d = { x: -1, y: 0 };
    else if (cmd === 'D') d = { x: 1, y: 0 };
    else if (cmd === 'F') d = DIR_DELTA[robot.dir];
    else return true;

    const nx = robot.x + d.x, ny = robot.y + d.y;
    if (nx < 0 || ny < 0 || nx >= lv.size || ny >= lv.size || walls.has(`${nx},${ny}`)) return false;

    const boxIndex = boxes.findIndex(b => b.x === nx && b.y === ny);
    if (boxIndex !== -1) {
      // Толкун умеет толкать ящики; остальные роботы не могут пройти сквозь них.
      if (currentRobotType !== 'tolkun') return false;
      const bx = nx + d.x, by = ny + d.y;
      if (bx < 0 || by < 0 || bx >= lv.size || by >= lv.size || walls.has(`${bx},${by}`)) return false;
      if (boxes.some(b => b.x === bx && b.y === by)) return false;
      boxes[boxIndex].x = bx;
      boxes[boxIndex].y = by;
      playSFX('push');
    }
    // Тягун цепляет ящик позади себя и переносит его на клетку, с которой ушёл.
    if (currentRobotType === 'tyagun' && cmd === 'F') {
      const behindX = robot.x - d.x, behindY = robot.y - d.y;
      const behindIndex = boxes.findIndex(b => b.x === behindX && b.y === behindY);
      if (behindIndex !== -1) {
        const oldX = robot.x, oldY = robot.y;
        if (walls.has(`${oldX},${oldY}`) || boxes.some((b, i) => i !== behindIndex && b.x === oldX && b.y === oldY)) return false;
        boxes[behindIndex].x = oldX; boxes[behindIndex].y = oldY;
        playSFX('push');
      }
    }
    robot.x = nx; robot.y = ny;
    return true;
  }

  function isWin() {
    const lv = levels[currentLevelIndex];
    const robotAtGoal = robot.x === goal.x && robot.y === goal.y;
    
    if (lv.type === 'maze') {
      return robotAtGoal;
    } else {
      // Проверяем, что ВСЕ ящики стоят на СВОИХ кнопках
      const allButtonsPressed = buttons.every(btn => 
        boxes.some(box => box.x === btn.x && box.y === btn.y && box.color === btn.color)
      );
      return allButtonsPressed && robotAtGoal;
    }
  }


  // Перетаскивание стрелок пальцем или мышью: из палитры в программу,
  // перестановка уже добавленных команд и удаление через корзину.
  (function enableCommandDragging(){
    let drag = null, ghost = null;
    const trash = document.createElement('div');
    trash.id = 'drag-trash'; trash.setAttribute('aria-label','Корзина'); trash.textContent = '🗑️';
    document.body.appendChild(trash);
    function symbol(cmd){ return CMD_SYMBOLS[cmd] || cmd; }
    function clearDrag(){
      if(ghost) ghost.remove(); ghost=null; drag=null;
      trash.classList.remove('visible','over');
      document.querySelectorAll('.cmd-slot.drop-target').forEach(el=>el.classList.remove('drop-target'));
    }
    document.addEventListener('pointerdown', e=>{
      if(running) return;
      const palette=e.target.closest('.btn-cmd');
      const slot=e.target.closest('.cmd-slot.filled');
      if(!palette && !slot) return;
      const cmd=palette ? (palette.getAttribute('onclick')||'').match(/addCommand\('([A-Z])'\)/)?.[1] : slot.dataset.cmd;
      if(!cmd) return;
      drag={cmd, source:palette?'palette':'slot', index:slot?Number(slot.dataset.index):-1, startX:e.clientX, startY:e.clientY, moved:false};
      ghost=document.createElement('div'); ghost.className='drag-ghost'; ghost.textContent=symbol(cmd); document.body.appendChild(ghost);
      ghost.style.left=e.clientX+'px'; ghost.style.top=e.clientY+'px';
      trash.classList.add('visible');
      try { e.target.setPointerCapture(e.pointerId); } catch(_){}
      e.preventDefault();
    }, {passive:false});
    document.addEventListener('pointermove', e=>{
      if(!drag||!ghost) return;
      if(Math.hypot(e.clientX-drag.startX,e.clientY-drag.startY)>5) drag.moved=true;
      ghost.style.left=e.clientX+'px'; ghost.style.top=e.clientY+'px';
      const el=document.elementFromPoint(e.clientX,e.clientY);
      document.querySelectorAll('.cmd-slot.drop-target').forEach(x=>x.classList.remove('drop-target'));
      const target=el&&el.closest('.cmd-slot'); if(target) target.classList.add('drop-target');
      const r=trash.getBoundingClientRect(); const over=e.clientX>=r.left&&e.clientX<=r.right&&e.clientY>=r.top&&e.clientY<=r.bottom;
      trash.classList.toggle('over',over);
    }, {passive:true});
    document.addEventListener('pointerup', e=>{
      if(!drag) return;
      const current=drag, el=document.elementFromPoint(e.clientX,e.clientY), target=el&&el.closest('.cmd-slot');
      const r=trash.getBoundingClientRect(); const overTrash=trash.classList.contains('over') || (e.clientX>=r.left&&e.clientX<=r.right&&e.clientY>=r.top&&e.clientY<=r.bottom);
      if(current.moved){
        if(overTrash && current.source==='slot') { program.splice(current.index,1); failedCommandIndex=-1; renderProgram(); playSFX('click'); }
        else if(target){
          const to=Math.min(Number(target.dataset.index), program.length);
          if(current.source==='palette'){
            if(program.length < levels[currentLevelIndex].maxCommands){ program.splice(to,0,current.cmd); failedCommandIndex=-1; renderProgram(); playSFX('click'); }
          } else {
            const from=current.index;
            if(from>=0 && to!==from){ const item=program.splice(from,1)[0]; program.splice(Math.min(to,program.length),0,item); failedCommandIndex=-1; renderProgram(); playSFX('click'); }
          }
        }
      }
      clearDrag();
    });
    document.addEventListener('pointercancel', clearDrag);
  })();

  generate30Levels();
  window.addEventListener('resize', () => { if (!gameScreen.classList.contains('hidden')) render(); });
</script>
</body>
</html>
