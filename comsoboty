<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Пикто-Мир — версия для телефона</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@600;800;900&display=swap');
  
  * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }
  body, html { height: 100%; overflow: hidden; font-family: 'Nunito', sans-serif; background: #1b0d40; }

  /* --- КОСМИЧЕСКИЙ ФОН --- */
  #space-bg { position: fixed; inset: 0; background: linear-gradient(135deg, #1b4d7a 0%, #0d2b45 100%); z-index: 0; }
  .stars { position: absolute; inset: 0; background-image: radial-gradient(1px 1px at 10% 10%, #fff, transparent), radial-gradient(1.5px 1.5px at 20% 40%, #fff, transparent), radial-gradient(2px 2px at 80% 30%, #fff, transparent), radial-gradient(1px 1px at 70% 80%, #fff, transparent); background-size: 200px 200px; opacity: 0.6; animation: twinkle 4s infinite alternate; }
  @keyframes twinkle { 0% { opacity: 0.3; } 100% { opacity: 0.8; } }
  
  .screen { position: absolute; inset: 0; z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; transition: opacity 0.3s ease; }
  .hidden { opacity: 0; pointer-events: none; z-index: -1; }

  /* --- ГЛАВНОЕ МЕНЮ --- */
  .menu-grid { position: relative; display: grid; grid-template-columns: 140px 140px 140px; grid-template-rows: 140px 140px 140px; gap: 12px; z-index: 2; }
  .btn-white { background: #ffffff; border-radius: 28px; border: none; cursor: pointer; display: flex; justify-content: center; align-items: center; box-shadow: 0 12px 35px rgba(0, 0, 0, 0.25); transition: 0.15s; }
  .btn-white:hover { transform: scale(1.05); box-shadow: 0 15px 40px rgba(0, 0, 0, 0.35); }
  .btn-white:active { transform: scale(0.95); }
  .btn-white svg { width: 65px; height: 65px; fill: #00a8ff; }
  .btn-play { grid-area: 1 / 2; }
  .btn-help { grid-area: 2 / 1; }
  .btn-planet { grid-area: 2 / 3; }
  .btn-settings { grid-area: 3 / 2; }

  .corner-btn { position: absolute; width: 80px; height: 80px; background: #ffffff; border-radius: 20px; border: none; cursor: pointer; display: flex; justify-content: center; align-items: center; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3); transform: rotate(45deg); transition: 0.15s; z-index: 3; }
  .corner-btn:hover { transform: rotate(45deg) scale(1.1); }
  .corner-btn:active { transform: rotate(45deg) scale(0.9); }
  .corner-btn svg { width: 45px; height: 45px; transform: rotate(-45deg); }
  .btn-rocket { top: 40px; right: 40px; }
  .btn-rocket svg { fill: #22c55e; }
  .btn-trash { bottom: 40px; right: 40px; }
  .btn-trash svg { fill: #ef4444; }

  /* --- ВЫБОР УРОВНЕЙ --- */
  .level-select-container { width: 90%; max-width: 1100px; height: 80%; display: flex; flex-direction: column; }
  .menu-title { color: #fff; font-size: 42px; font-weight: 900; letter-spacing: 2px; margin-bottom: 20px; text-shadow: 0 4px 15px rgba(0,0,0,0.5); text-align: center; }
  .level-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 15px; overflow-y: auto; padding: 10px; flex: 1; }
  
  .card { background: rgba(255,255,255,0.1); border-radius: 15px; padding: 10px; display: flex; flex-direction: column; align-items: center; cursor: pointer; transition: 0.2s; border: 1px solid rgba(255,255,255,0.05); position: relative; }
  .card:hover { transform: translateY(-5px); background: rgba(255,255,255,0.2); }
  .card.locked { opacity: 0.5; cursor: not-allowed; filter: grayscale(1); }
  .card-title { color: #fff; font-size: 18px; font-weight: 800; margin-bottom: 5px; }
  .card-status { font-size: 14px; color: #ffb300; font-weight: 800; }
  .card-status.done { color: #22c55e; }

  .back-btn-menu { margin-top: 15px; background: rgba(255,255,255,0.2); border: none; color: #fff; padding: 10px 30px; border-radius: 12px; font-weight: 800; font-size: 16px; cursor: pointer; transition: 0.2s; align-self: center; }
  .back-btn-menu:hover { background: rgba(255,255,255,0.3); }

  /* --- ИНТЕРФЕЙС ИГРЫ --- */
  #game-ui { position: absolute; inset: 0; z-index: 1; display: flex; flex-direction: column; }
  .top-bar { display: flex; justify-content: space-between; align-items: flex-start; padding: 20px; width: 100%; height: 80px; }
  .back-btn { width: 50px; height: 50px; border-radius: 50%; background: rgba(255,255,255,0.9); border: none; display: flex; justify-content: center; align-items: center; cursor: pointer; box-shadow: 0 4px 10px rgba(0,0,0,0.3); color: #3498db; font-size: 24px; font-weight: 900; transition: 0.2s; }
  .back-btn:hover { transform: scale(1.1); }
  .level-display { color: #fff; font-size: 24px; font-weight: 900; text-shadow: 0 2px 10px rgba(0,0,0,0.5); }

  /* Плашки */
  .notification { position: absolute; top: -120px; left: 50%; transform: translateX(-50%); background: linear-gradient(135deg, #60a5fa 0%, #3b82f6 100%); border: 4px solid #2563eb; border-radius: 20px; padding: 12px 25px; display: flex; align-items: center; gap: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); transition: top 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); z-index: 100; }
  .notification.show { top: 20px; }
  .notification .icon { background: #1e3a8a; width: 50px; height: 50px; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 28px; }
  .notification .text { color: #fff; font-size: 22px; font-weight: 900; line-height: 1.1; text-shadow: 0 2px 4px rgba(0,0,0,0.2); }
  .notification.success { background: linear-gradient(135deg, #4ade80 0%, #22c55e 100%); border-color: #16a34a; }
  .notification.success .icon { background: #166534; }

  /* Поле */
  .game-layout { flex: 1; display: flex; justify-content: center; align-items: center; gap: 60px; padding: 0 40px; }
  .iso-container { perspective: 1500px; width: 500px; height: 500px; display: flex; justify-content: center; align-items: center; }
  #board-wrapper { position: relative; transform-style: preserve-3d; transition: transform 0.3s ease; }
  #board { --cell-size: 60px; display: grid; transform: rotateX(60deg) rotateZ(-45deg); transform-style: preserve-3d; gap: calc(var(--cell-size) * .067); padding: calc(var(--cell-size) * .15); background: #fbc02d; border-radius: 12px; box-shadow: -20px 20px 0 #f57f17, 0 40px 50px rgba(0,0,0,0.6); }
  .cell { width: var(--cell-size, 60px); height: var(--cell-size, 60px); border-radius: 6px; position: relative; transform-style: preserve-3d; background: #0288d1; border: 2px solid #03a9f4; box-shadow: inset 0 0 10px rgba(255,255,255,0.4); }
  
  /* Стены */
  .wall-block { width: 50px; height: 50px; position: absolute; top: 5px; left: 5px; background: linear-gradient(135deg, #90a4ae, #546e7a); border-radius: 6px; transform: translateZ(25px) rotateX(-60deg) rotateZ(45deg); box-shadow: 0 15px 10px rgba(0,0,0,0.4), inset 0 0 10px rgba(255,255,255,0.3); border: 2px solid #cfd8dc; display: flex; justify-content: center; align-items: center; }
  .wall-block::after { content: '⚠'; color: #cfd8dc; font-size: 24px; font-weight: bold; }

  /* Кнопки */
  .button-target {
    width: 46px; height: 46px; position: absolute; top: 7px; left: 7px;
    border-radius: 8px; transform: translateZ(1px);
    box-shadow: inset 0 0 10px rgba(0,0,0,0.5); border: 2px solid rgba(255,255,255,0.5);
  }
  .button-target.pressed { filter: brightness(1.5); box-shadow: 0 0 20px currentColor, inset 0 0 10px #fff; }

  /* 3D Ящики */
  .crate {
    width: 40px; height: 40px; position: absolute; top: 10px; left: 10px;
    transform-style: preserve-3d;
    transform: translateZ(20px) rotateX(-60deg) rotateZ(45deg);
    transition: top 0.3s, left 0.3s;
  }
  .crate .face { position: absolute; width: 40px; height: 40px; border: 2px solid rgba(0,0,0,0.3); }
  .crate .front { transform: translateZ(20px); }
  .crate .back { transform: rotateY(180deg) translateZ(20px); }
  .crate .left { transform: rotateY(-90deg) translateZ(20px); }
  .crate .right { transform: rotateY(90deg) translateZ(20px); }
  .crate .top { transform: rotateX(90deg) translateZ(20px); filter: brightness(1.2); }
  .crate .bottom { transform: rotateX(-90deg) translateZ(20px); filter: brightness(0.7); }

  /* Портал */
  .portal { width: 40px; height: 40px; border-radius: 50%; transform: translateZ(2px); position: absolute; top: 10px; left: 10px; }
  .portal::before { content: ''; position: absolute; inset: -4px; border-radius: 50%; background: conic-gradient(from 0deg, #10b981, #34d399, #10b981); animation: spin 2s linear infinite; filter: blur(2px); }
  .portal::after { content: ''; position: absolute; inset: 4px; border-radius: 50%; background: #fff; box-shadow: 0 0 15px #10b981; }
  @keyframes spin { 100% { transform: rotate(360deg); } }

  /* Робот */
  .robot-container { position: absolute; top: 0; left: 0; width: 60px; height: 60px; transform-style: preserve-3d; transition: transform 0.3s ease-in-out; }
  .robot-visual { width: 100%; height: 100%; position: relative; transform-style: preserve-3d; }
  .robot-shadow { position: absolute; bottom: -10px; left: 5px; width: 50px; height: 20px; background: rgba(0,0,0,0.5); border-radius: 50%; filter: blur(4px); transform: rotateX(90deg) translateZ(-10px); }
  .r-base { position: absolute; bottom: 0; left: 5px; width: 50px; height: 15px; background: linear-gradient(to bottom, #b0bec5, #78909c); border-radius: 10px 10px 5px 5px; border: 2px solid #90a4ae; box-shadow: inset 0 5px 5px rgba(255,255,255,0.5); }
  .r-base-segment { position: absolute; bottom: 5px; left: 10px; width: 40px; height: 5px; background: #546e7a; border-radius: 2px; }
  .r-body { position: absolute; bottom: 15px; left: 10px; width: 40px; height: 35px; background: linear-gradient(to right, #f57f17, #ffca28, #f57f17); border-radius: 15px 15px 5px 5px; border: 2px solid #e65100; box-shadow: inset 0 -5px 10px rgba(0,0,0,0.2); }
  .r-dome { position: absolute; bottom: 48px; left: 8px; width: 44px; height: 30px; background: rgba(255, 255, 255, 0.4); border-radius: 22px 22px 5px 5px; border: 2px solid rgba(255,255,255,0.8); box-shadow: inset 5px 5px 10px rgba(255,255,255,0.6); backdrop-filter: blur(2px); }
  .r-face-panel { position: absolute; bottom: 22px; left: 12px; width: 36px; height: 18px; background: #222; border-radius: 8px; border: 2px solid #000; display: flex; justify-content: space-around; align-items: center; padding: 0 4px; box-shadow: inset 0 0 5px rgba(0,255,255,0.5); }
  .r-eye { width: 10px; height: 10px; background: #0ff; border-radius: 50%; box-shadow: 0 0 8px #0ff; }
  .r-back-panel { position: absolute; bottom: 22px; left: 12px; width: 36px; height: 18px; background: #444; border-radius: 8px; border: 2px solid #111; display: flex; justify-content: center; align-items: center; transform: rotateY(180deg); }
  .r-back-light { width: 14px; height: 6px; background: #f00; border-radius: 3px; box-shadow: 0 0 10px #f00; }
  .r-antenna { position: absolute; bottom: 75px; left: 28px; width: 4px; height: 15px; background: #ffca28; border: 1px solid #e65100; }
  .r-antenna-tip { position: absolute; bottom: 88px; left: 25px; width: 10px; height: 10px; background: #ffca28; border-radius: 50%; border: 2px solid #e65100; box-shadow: 0 0 5px #ffca28; }

  /* Панель */
  .panel { background: rgba(255,255,255,0.95); border-radius: 20px; padding: 20px; width: 340px; box-shadow: 0 10px 30px rgba(0,0,0,0.4); backdrop-filter: blur(10px); }
  .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
  .robot-picker { display:flex; gap:6px; flex-wrap:wrap; margin:8px 0 10px; }
  .robot-pick { flex:1; min-width:82px; border:2px solid #cbd5e1; border-radius:10px; padding:7px 5px; background:#f8fafc; color:#1e293b; font-weight:800; cursor:pointer; font-size:12px; }
  .robot-pick.active { border-color:#2563eb; background:#dbeafe; box-shadow:0 0 0 2px #93c5fd inset; }
  .robot-ability { font-size:11px; line-height:1.35; color:#475569; background:#eff6ff; border-radius:8px; padding:7px 9px; margin-bottom:8px; }
  .robot-ability strong { color:#1d4ed8; }
  .robot-container.robot-tolkun { filter: drop-shadow(0 8px 5px rgba(0,35,75,.35)) hue-rotate(0deg); }
  .robot-container.robot-tyagun { filter: drop-shadow(0 8px 5px rgba(0,35,75,.35)) hue-rotate(95deg) saturate(1.25); }
  .robot-container.robot-prygun { filter: drop-shadow(0 8px 5px rgba(0,35,75,.35)) hue-rotate(210deg) saturate(1.3); }
  .robot-type-badge { position:absolute; right:-8px; top:-12px; z-index:32; font-size:18px; background:#fff; border-radius:50%; padding:2px; box-shadow:0 2px 5px #0004; }
  .btn-jump { background:#7c3aed !important; color:white !important; }

  .panel h2 { font-size: 18px; color: #1f2a44; text-transform: uppercase; margin: 0; }
  .cmd-counter { font-size: 14px; font-weight: 800; color: #64748b; background: #f1f5f9; padding: 4px 10px; border-radius: 8px; }
  #program { min-height: 60px; background: #f1f6ff; border: 2px solid #b9c6e0; border-radius: 12px; padding: 10px; display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 15px; align-content: flex-start; }
  .cmd-slot { width: 44px; height: 44px; border-radius: 8px; display: flex; justify-content: center; align-items: center; font-size: 24px; font-weight: bold; transition: 0.2s; }
  .cmd-slot.empty { border: 2px dashed #cbd5e1; background: transparent; }
  .cmd-slot.filled { background: #fff; border: 2px solid #9fb0ce; color: #00a8ff; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
  .cmd-slot.active { background: #fbbf24; color: #000; border-color: #d97706; transform: scale(1.1); box-shadow: 0 0 15px #fbbf24; }
  .btn-row { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; margin-bottom: 15px; }
  button.action { border: none; border-radius: 12px; padding: 12px; font-size: 16px; font-weight: 800; cursor: pointer; transition: 0.1s; }
  button.action:active { transform: scale(0.95); }
  .btn-cmd { background: #e0f2fe; color: #0369a1; font-size: 20px; }
  .btn-run { background: #22c55e; color: #fff; font-size: 18px; box-shadow: 0 4px 10px rgba(34,197,94,0.4); grid-column: span 2; }
  .btn-clear { background: #fee2e2; color: #b91c1c; }
  .btn-undo { background: #fef08a; color: #854d0e; }
  #status { background: #f8fafc; border: 1px solid #e2e8f0; padding: 15px; border-radius: 12px; font-size: 15px; color: #334155; min-height: 60px; text-align: center; }

  /* --- ОБНОВЛЁННЫЙ ИГРОВОЙ ЭКРАН: яркая космическая 3D-платформа --- */
  #space-bg {
    background:
      radial-gradient(circle at 72% 25%, rgba(112,238,255,.55), transparent 28%),
      radial-gradient(circle at 22% 78%, rgba(90,135,255,.35), transparent 32%),
      linear-gradient(125deg, #3158a7 0%, #25b8d5 52%, #40c8db 100%);
  }
  #game-ui { overflow: hidden; }
  #game-ui .top-bar {
    height: 72px; padding: 16px 22px; align-items: center;
  }
  #game-ui .back-btn {
    background: linear-gradient(145deg,#fff,#dff8ff);
    color: #1686c4; border: 3px solid rgba(255,255,255,.75);
    box-shadow: 0 5px 0 rgba(16,93,150,.25), 0 8px 18px rgba(0,0,0,.18);
  }
  #game-ui .level-display {
    background: rgba(255,255,255,.2); border: 2px solid rgba(255,255,255,.35);
    border-radius: 16px; padding: 9px 18px; backdrop-filter: blur(8px);
  }
  #game-ui .game-layout {
    gap: clamp(16px, 3vw, 48px); padding: 0 clamp(12px, 3vw, 40px) 22px;
    min-height: 0;
  }
  #game-ui .iso-container {
    width: min(58vw, 760px); height: min(76vh, 700px);
    flex: 1 1 0; min-width: 0; overflow: visible;
  }
  #board {
    gap: 4px; padding: 10px;
    background: linear-gradient(135deg,#ffe72e,#ffc400);
    border: 2px solid #fff17a; border-radius: 8px;
    box-shadow: -18px 18px 0 #df9700, 0 28px 42px rgba(0,35,75,.28);
  }
  .cell {
    background:
      repeating-linear-gradient(0deg, transparent 0 7px, rgba(0,190,255,.12) 7px 9px),
      linear-gradient(145deg,#08caff,#0087db);
    border: 2px solid #00b8f5; border-radius: 7px;
    box-shadow: inset 0 0 0 2px rgba(255,255,255,.12), inset 0 0 12px rgba(0,49,140,.22);
  }
  #game-ui .panel {
    flex: 0 0 320px; width: min(320px, 34vw); max-height: 78vh; overflow-y: auto;
    background: linear-gradient(160deg,rgba(255,255,255,.98),rgba(226,248,255,.96));
    border: 3px solid rgba(255,255,255,.75); border-radius: 22px;
    box-shadow: 0 16px 38px rgba(0,45,90,.28);
  }
  #game-ui .panel h2 { color: #0877a8; }
  #game-ui #program { background: #e8f8ff; border-color: #9edff5; }
  #game-ui .btn-cmd {
    background: linear-gradient(180deg,#e7fbff,#b8efff);
    color: #087fb4; border: 2px solid #8bdcf5;
    box-shadow: 0 3px 0 #7cc9e5;
  }
  #game-ui .btn-run {
    background: linear-gradient(180deg,#39df85,#16a75a);
    box-shadow: 0 4px 0 #0b8746, 0 8px 14px rgba(34,197,94,.25);
  }
  #game-ui #status { background: #f0fbff; border-color: #b8e8f5; }
  @media (max-width: 850px) {
    #game-ui .game-layout { flex-direction: column; gap: 8px; padding: 0 12px 12px; }
    #game-ui .iso-container { width: 94vw; height: 48vh; flex: 1 1 auto; }
    #game-ui .panel { flex: 0 0 auto; width: min(94vw, 520px); max-height: 42vh; padding: 12px; }
    #game-ui .top-bar { padding: 10px 14px; height: 60px; }
    #game-ui .level-display { font-size: 18px; }
  }



  .robot-direction-badge { position:absolute; left:50%; top:-45px; transform:translateX(-50%) rotateZ(-45deg) rotateX(60deg); display:flex; flex-direction:column; align-items:center; gap:1px; z-index:30; pointer-events:none; white-space:nowrap; font-size:10px; font-weight:900; color:#102a43; text-shadow:0 1px #fff; }
  .direction-arrow { display:flex; align-items:center; justify-content:center; width:27px; height:27px; border-radius:50%; background:#ffdf42; border:2px solid #fff; box-shadow:0 2px 8px #123b65; font-size:18px; }
  /* Детализированный робот в духе оригинального персонажа Пикто-Мир */
  .robot-container { width: 60px; height: 80px; overflow: visible; }
  .robot-visual { width: 100%; height: 100%; overflow: visible; }
  .pictomir-robot-sprite {
    position: absolute; width: 70px; height: 98px; left: -5px; bottom: -8px;
    object-fit: contain; filter: drop-shadow(0 3px 2px rgba(4,48,77,.25));
    pointer-events: none;
  }


  /* Объёмная платформа в духе оригинального Пикто-Мир */
  #space-bg {
    background:
      radial-gradient(ellipse at 53% 48%, rgba(47,211,241,.9) 0%, rgba(44,173,218,.72) 23%, transparent 49%),
      linear-gradient(125deg,#3155a3 0%,#2b6cb3 45%,#319fc8 100%) !important;
  }
  .stars {
    opacity: .72;
    background-image:
      radial-gradient(2px 2px at 10% 12%,#fff,transparent),
      radial-gradient(2px 2px at 28% 34%,#a9f5ff,transparent),
      radial-gradient(2px 2px at 73% 18%,#fff,transparent),
      radial-gradient(2px 2px at 86% 64%,#f4a7ff,transparent),
      radial-gradient(1.5px 1.5px at 54% 79%,#fff,transparent);
    background-size: 240px 210px;
  }
  .iso-container { perspective: 1100px !important; }
  #board {
    gap: 4px !important;
    padding: 9px !important;
    border-radius: 3px !important;
    background: linear-gradient(145deg,#ffe72a,#ffbf00 72%,#f7a900) !important;
    border: 1px solid #fff27c !important;
    box-shadow:
      -1px 1px 0 #fff67a,
      -2px 3px 0 #e8b500,
      -4px 6px 0 #dca000,
      -6px 9px 0 #c88700,
      0 22px 32px rgba(0,24,65,.35) !important;
  }
  .cell {
    border-radius: 5px !important;
    border: 2px solid #00b7ed !important;
    background:
      repeating-linear-gradient(0deg,transparent 0 5px,rgba(0,80,200,.09) 5px 6px),
      radial-gradient(ellipse at 35% 25%,#18d8ff 0%,#00aaf0 48%,#0079ce 100%) !important;
    box-shadow:
      inset 2px 2px 0 rgba(255,255,255,.48),
      inset -3px -4px 0 rgba(0,62,155,.24),
      inset 0 0 12px rgba(0,78,181,.28),
      0 2px 0 #0066bd !important;
  }
  .cell::before {
    content: "";
    position: absolute;
    inset: 5px;
    border: 1px solid rgba(112,235,255,.45);
    border-radius: 3px;
    pointer-events: none;
    background: repeating-linear-gradient(45deg,transparent 0 8px,rgba(255,255,255,.035) 8px 10px);
  }
  .wall-block {
    background: linear-gradient(145deg,#d9eaf0 0%,#a8c6d2 40%,#668b9b 100%) !important;
    border: 2px solid #f6ffff !important;
    box-shadow:
      inset 3px 3px 0 rgba(255,255,255,.75),
      inset -4px -4px 0 rgba(42,80,105,.22),
      0 5px 0 #577989,
      0 10px 9px rgba(0,24,50,.3) !important;
  }
  .robot-container { filter: drop-shadow(0 8px 5px rgba(0,35,75,.35)); }
  .pictomir-robot-sprite {
    filter: drop-shadow(1px 2px 0 rgba(255,255,255,.4))
            drop-shadow(0 5px 4px rgba(0,36,70,.32)) !important;
  }
  .r-base, .r-dome, .r-body { transform-style: preserve-3d; }
