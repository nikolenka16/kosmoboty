<script>
  // =========================================
  // АУДИО
  // =========================================
  let audioCtx;
  let musicEnabled = true;
  let sfxEnabled = true;
  let musicInterval = null;

  function initAudio() {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
  }

  function playTone(freq, type, duration, vol, isMusic = false) {
    if (!audioCtx) return;
    if (!isMusic && !sfxEnabled) return;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
    gain.gain.setValueAtTime(vol, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + duration);
  }

  function playSFX(type) {
    initAudio();
    if (!sfxEnabled) return;
    switch(type) {
      case 'click': playTone(600, 'sine', 0.1, 0.1); break;
      case 'step': playTone(350, 'triangle', 0.1, 0.15); break;
      case 'turn': playTone(450, 'sine', 0.15, 0.1); break;
      case 'push': playTone(200, 'square', 0.2, 0.1); break;
      case 'error': playTone(150, 'sawtooth', 0.3, 0.1); setTimeout(() => playTone(120, 'sawtooth', 0.3, 0.1), 150); break;
      case 'win': playTone(523.25, 'sine', 0.1, 0.15); setTimeout(() => playTone(659.25, 'sine', 0.1, 0.15), 100); setTimeout(() => playTone(783.99, 'sine', 0.1, 0.15), 200); setTimeout(() => playTone(1046.50, 'sine', 0.4, 0.15), 300); break;
    }
  }

  function startMusic() {
    initAudio();
    if (!musicEnabled || musicInterval) return;
    const bassNotes = [130.81, 146.83, 164.81, 146.83];
    const melodyNotes = [523.25, 587.33, 659.25, 783.99, 659.25, 587.33];
    let bassIndex = 0;
    let melodyIndex = 0;
    musicInterval = setInterval(() => {
      if (musicEnabled && audioCtx.state === 'running') {
        playTone(bassNotes[bassIndex % bassNotes.length], 'triangle', 2.5, 0.08, true);
        if (bassIndex % 2 === 0) {
           playTone(melodyNotes[melodyIndex % melodyNotes.length], 'sine', 1.5, 0.04, true);
           melodyIndex++;
        }
        bassIndex++;
      }
    }, 1500);
  }

  // =========================================
  // ЛОГИКА
  // =========================================
  const DIRS = { UP: 0, RIGHT: 1, DOWN: 2, LEFT: 3 };
  const DIR_DELTA = [ { x: 0, y: -1 }, { x: 1, y: 0 }, { x: 0, y: 1 }, { x: -1, y: 0 } ];
  const CMD_SYMBOLS = { F: '⬆', A: '⬅', D: '➡', L: '↺', R: '↻', J: '⤴' };

  const mainMenuEl = document.getElementById('main-menu');
  const levelSelectScreen = document.getElementById('level-select-screen');
  const gameScreen = document.getElementById('game-ui');
  
  const boardEl = document.getElementById('board');
  const boardWrapper = document.getElementById('board-wrapper');
  const programEl = document.getElementById('program');
  const statusEl = document.getElementById('status');
  const cmdCounterEl = document.getElementById('cmd-counter');
  const levelDisplay = document.getElementById('level-display');
  const notification = document.getElementById('notification');
  const notifText = document.getElementById('notif-text');
  const levelGrid = document.getElementById('level-grid');

  let levels = [];
  let currentLevelIndex = 0;
  let robot = { x: 0, y: 0, dir: 0 };
  let walls = new Set();
  let boxes = [];
  let buttons = [];
  let goal = { x: 0, y: 0 };
  let program = [];
  let running = false;
  let timer = null;
  let unlockedLevel = 0;
  let failedCommandIndex = -1;
  let currentRobotType = 'tolkun';
  const ROBOT_INFO = {
    tolkun: {name:'Толкун', icon:'🟠', text:'Толкает ящики перед собой. Подходит для задач с кнопками.'},
    tyagun: {name:'Тягун', icon:'🟢', text:'Когда идёт вперёд, тянет ящик, стоящий прямо за ним, на прежнее место робота.'},
    prygun: {name:'Прыгун', icon:'🔵', text:'Команда ⤴ перепрыгивает через одну клетку. Приземляться можно только на свободную клетку.'}
  };

  const COLORS = {
    red: { bg: '#ef4444', front: '#b91c1c' },
    green: { bg: '#22c55e', front: '#15803d' },
    blue: { bg: '#3b82f6', front: '#1d4ed8' }
  };

  // BFS для поиска пути
  function getShortestPath(start, goal, wallSet, size) {
    const queue = [{ x: start.x, y: start.y, dist: 0 }];
    const visited = new Set([`${start.x},${start.y}`]);
    while (queue.length > 0) {
      const { x, y, dist } = queue.shift();
      if (x === goal.x && y === goal.y) return dist;
      for (const d of DIR_DELTA) {
        const nx = x + d.x, ny = y + d.y;
        if (nx >= 0 && ny >= 0 && nx < size && ny < size && !wallSet.has(`${nx},${ny}`) && !visited.has(`${nx},${ny}`)) {
          visited.add(`${nx},${ny}`);
          queue.push({ x: nx, y: ny, dist: dist + 1 });
        }
      }
    }
    return -1;
  }

  function generateMaze(size) {
    const grid = Array(size).fill().map(() => Array(size).fill(1));
    const stack = [{x: 1, y: 1}];
    grid[1][1] = 0;
    while (stack.length > 0) {
      const {x, y} = stack[stack.length - 1];
      const neighbors = [];
      if (x > 2 && grid[y][x-2] === 1) neighbors.push({x: x-2, y, dx: -1, dy: 0});
      if (x < size-3 && grid[y][x+2] === 1) neighbors.push({x: x+2, y, dx: 1, dy: 0});
      if (y > 2 && grid[y-2][x] === 1) neighbors.push({x, y: y-2, dx: 0, dy: -1});
      if (y < size-3 && grid[y+2][x] === 1) neighbors.push({x, y: y+2, dx: 0, dy: 1});
      if (neighbors.length > 0) {
        const next = neighbors[Math.floor(Math.random() * neighbors.length)];
        grid[y + next.dy][x + next.dx] = 0;
        grid[next.y][next.x] = 0;
        stack.push({x: next.x, y: next.y});
      } else {
        stack.pop();
      }
    }
    return grid;
  }

  function generate30Levels() {
    levels = [];
    
    // Шаблоны Сокобана (Максимум 3 ящика)
    const sokobanTemplates = [
      {
        // 1 ящик
        size: 5, start: {x: 1, y: 3, dir: DIRS.UP},
        walls: [[2,1], [1,1], [3,1], [2,4]],
        boxes: [{x: 2, y: 2, color: 'red'}],
        buttons: [{x: 2, y: 0, color: 'red'}],
        goal: {x: 4, y: 0}, maxCommands: 10
      },
      {
        // 2 ящика
        size: 6, start: {x: 1, y: 4, dir: DIRS.UP},
        walls: [[1,2], [3,2], [5,2], [3,4], [4,4]],
        boxes: [{x: 2, y: 3, color: 'red'}, {x: 4, y: 3, color: 'blue'}],
        buttons: [{x: 2, y: 1, color: 'red'}, {x: 4, y: 1, color: 'blue'}],
        goal: {x: 0, y: 0}, maxCommands: 20
      },
      {
        // 3 ящика
        size: 7, start: {x: 3, y: 5, dir: DIRS.UP},
        walls: [[2,2], [4,2], [1,3], [5,3], [3,1]],
        boxes: [
          {x: 3, y: 4, color: 'red'}, 
          {x: 2, y: 3, color: 'blue'}, 
          {x: 4, y: 3, color: 'green'}
        ],
        buttons: [
          {x: 3, y: 2, color: 'red'}, 
          {x: 0, y: 3, color: 'blue'}, 
          {x: 6, y: 3, color: 'green'}
        ],
        goal: {x: 3, y: 0}, maxCommands: 30
      }
    ];

    for (let i = 0; i < 30; i++) {
      if (i % 2 === 0) {
        // ЧЕТНЫЕ: ЛАБИРИНТЫ БЕЗ ЯЩИКОВ
        let size = 7 + Math.floor(i / 6);
        let start = { x: 1, y: size - 2, dir: DIRS.UP };
        let goal = { x: size - 2, y: 1 };
        let grid = generateMaze(size);
        grid[start.y][start.x] = 0;
        grid[goal.y][goal.x] = 0;
        let walls = [];
        for (let y = 0; y < size; y++) {
          for (let x = 0; x < size; x++) {
            if (grid[y][x] === 1) walls.push([x, y]);
          }
        }
        const wallsSet = new Set(walls.map(w => `${w[0]},${w[1]}`));
        let pathLen = getShortestPath(start, goal, wallsSet, size);

        levels.push({
          type: 'maze',
          size: size, maxCommands: pathLen + 2,
          start: start, goal: goal, walls: walls,
          boxes: [], buttons: []
        });
      } else {
        // НЕЧЕТНЫЕ: СОКОБАН (1, 2, 3 ЯЩИКА)
        let templateIndex = Math.floor(i / 2) % 3; // Чередуем 1, 2 и 3 ящика
        let base = sokobanTemplates[templateIndex];
        levels.push({
          type: 'sokoban',
          size: base.size,
          start: base.start,
          walls: [...base.walls],
          boxes: JSON.parse(JSON.stringify(base.boxes)),
          buttons: JSON.parse(JSON.stringify(base.buttons)),
          goal: base.goal,
          maxCommands: base.maxCommands
        });
      }
    }
  }

  function renderLevelGrid() {
    levelGrid.innerHTML = '';
    levels.forEach((lvl, index) => {
      const card = document.createElement('div');
      card.className = `card ${index > unlockedLevel ? 'locked' : ''}`;
      card.onclick = () => startLevel(index);
      const isDone = index < unlockedLevel;
      const statusText = isDone ? 'Пройден ✅' : (index === unlockedLevel ? 'Играть ▶' : 'Закрыто 🔒');
      
      let typeName = lvl.type === 'maze' ? 'Лабиринт' : `Ящики (${lvl.boxes.length})`;
      
      card.innerHTML = `
        <div class="card-title">Миссия ${index + 1}</div>
        <div style="font-size:12px; color:#cbd5e1; margin-bottom:5px;">${typeName}</div>
        <div class="card-status ${isDone ? 'done' : ''}">${statusText}</div>
      `;
      levelGrid.appendChild(card);
    });
  }

  function showMainMenu() {
    mainMenuEl.classList.remove('hidden');
    levelSelectScreen.classList.add('hidden');
    gameScreen.classList.add('hidden');
    clearTimeout(timer);
  }

  function showLevelSelect() {
    mainMenuEl.classList.add('hidden');
    gameScreen.classList.add('hidden');
    levelSelectScreen.classList.remove('hidden');
    clearTimeout(timer);
    renderLevelGrid();
  }

  function startLevel(index) {
    if (index > unlockedLevel) return;
    playSFX('click');
    currentLevelIndex = index;
    levelSelectScreen.classList.add('hidden');
    gameScreen.classList.remove('hidden');
    loadLevel();
  }

  // На каждых двух уровнях доступна своя пара роботов.
  // Пары меняются с самого начала игры, а не только на поздних уровнях.
  function availableRobotsForLevel(index = currentLevelIndex) {
    const pairs = [
      ['tolkun', 'tyagun'],
      ['tolkun', 'prygun'],
      ['tyagun', 'prygun']
    ];
    return pairs[Math.floor(index / 2) % pairs.length];
  }

  function updateRobotPicker() {
    const available = availableRobotsForLevel();
    document.querySelectorAll('.robot-pick').forEach(btn => {
      const shown = available.includes(btn.dataset.robot);
      btn.hidden = !shown;
      btn.disabled = !shown;
      btn.classList.toggle('active', btn.dataset.robot === currentRobotType);
    });
    if (!available.includes(currentRobotType)) currentRobotType = available[0];
    document.querySelectorAll('.robot-pick').forEach(btn => btn.classList.toggle('active', btn.dataset.robot === currentRobotType));
  }

  function selectRobot(type) {
    if (running) return;
    if (!ROBOT_INFO[type] || !availableRobotsForLevel().includes(type)) return;
    currentRobotType = type;
    document.querySelectorAll('.robot-pick').forEach(btn => btn.classList.toggle('active', btn.dataset.robot === type));
    const info = ROBOT_INFO[type];
    const ability = document.getElementById('robot-ability');
    if (ability) ability.innerHTML = `<strong>${info.name}:</strong> ${info.text}`;
    playSFX('click');
    render();
  }

  function loadLevel() {
    const lv = levels[currentLevelIndex];
    robot = { x: lv.start.x, y: lv.start.y, dir: lv.start.dir };
    goal = lv.goal;
    walls = new Set(lv.walls.map(w => `${w[0]},${w[1]}`));
    boxes = JSON.parse(JSON.stringify(lv.boxes));
    buttons = JSON.parse(JSON.stringify(lv.buttons));
    
    program = []; running = false;
    clearTimeout(timer);
    hideNotification();
    
    if (lv.type === 'maze') {
      statusEl.textContent = 'Доведите робота до портала!';
    } else {
      statusEl.textContent = 'Поставьте все ящики на кнопки!';
    }
    levelDisplay.textContent = `Миссия ${currentLevelIndex + 1}`;
    selectRobotUI();
    render();
  }

  function selectRobotUI() {
    updateRobotPicker();
    const info = ROBOT_INFO[currentRobotType];
    const ability = document.getElementById('robot-ability');
    if (ability && info) ability.innerHTML = `<strong>${info.name}:</strong> ${info.text}`;
  }

  function restartCurrentLevel() {
    if (running) return;
    playSFX('click');
    loadLevel();
  }

